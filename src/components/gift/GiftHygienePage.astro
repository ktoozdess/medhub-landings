---
import type { Locale, LandingCopy } from '../../data/landings';
import type { BentoExtras } from '../../data/bento-extras';
import { GIFT_CHROME } from '../../data/gift-chrome';
import { UI_CHROME } from '../../data/landings';

interface Props {
  locale: Locale;
  data: LandingCopy;
  extras: BentoExtras;
}

const { locale, data, extras } = Astro.props;
const ui = UI_CHROME[locale];
const chrome = GIFT_CHROME[locale].hygiene;
const stamps = ['0:00', '0:20', '0:45'];
---

<section class="gh-hero">
  <div class="container gh-hero-inner">
    <div class="gh-art" aria-hidden="true">
      <svg viewBox="0 0 280 280" fill="none">
        <circle class="gh-orb" cx="140" cy="148" r="92" stroke="#d4a843" stroke-width="1" />
        <circle class="gh-orb gh-orb-2" cx="140" cy="148" r="68" stroke="rgba(11,11,11,0.12)" />
        <path
          d="M140 58c22 0 38 13 41 32 3 26-3 46-9 72-3 16-9 38-19 38-6 0-9-12-12-24-2-7-4-7-6 0-3 12-6 24-12 24-10 0-16-22-19-38-6-26-12-46-9-72 3-19 19-32 41-32h4z"
          fill="#fff"
          stroke="#0b0b0b"
          stroke-width="2.2"
          stroke-linejoin="round"
        />
        <path d="M168 72c10 5 16 2 22-8 2 12-4 22-14 26" stroke="#d4a843" stroke-width="2" stroke-linecap="round" />
        <path class="gh-spark" d="M214 52l5 12 12 5-12 5-5 12-5-12-12-5 12-5 5-12z" fill="#d4a843" />
        <path class="gh-spark gh-s2" d="M58 96l3.5 8 8 3.5-8 3.5L58 119l-3.5-8-8-3.5 8-3.5L58 96z" fill="#0b0b0b" />
        <path class="gh-spark gh-s3" d="M232 168l4 9 9 4-9 4-4 9-4-9-9-4 9-4 4-9z" fill="#d4a843" />
      </svg>
      <p>{chrome.duration}</p>
    </div>
    <div>
      <span class="micro-label">{data.microLabel}</span>
      <h1 class="display-h1">{data.heroTitle}</h1>
      <p class="lead-text">{data.heroSubtitle}</p>
      <p class="gh-note">{chrome.sparkleNote}</p>
      <a class="btn-primary" href={`/${locale}${data.valueSection.ctaHrefSuffix}`}>
        <span>{data.valueSection.cta}</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<section id="how-it-works" class="gh-ritual">
  <div class="container">
    <span class="micro-label">{chrome.ritualLabel}</span>
    <h2 class="section-h2">{data.stepsSection.title}</h2>
    <ol>
      {data.stepsSection.cards.map((card, idx) => (
        <li>
          <time>{stamps[idx]}</time>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="gh-receipt-wrap">
  <div class="container gh-receipt-grid">
    <div>
      <span class="micro-label">{chrome.receiptLabel}</span>
      <h2 class="section-h2">{extras.tabsSection.title}</h2>
      <p class="lead-text">{data.valueSection.text}</p>
    </div>
    <div class="gh-receipt">
      {extras.tabsSection.tabs.map((tab) => (
        <div class="gh-line">
          <strong>{tab.label}</strong>
          <span>{tab.headline}</span>
        </div>
      ))}
      <ul class="check-list">
        {extras.tabsSection.tabs.flatMap((tab) => tab.metrics.slice(0, 1)).map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section-white">
  <div class="container">
    <span class="micro-label">{data.comparisonSection.microLabel}</span>
    <h2 class="section-h2">{data.comparisonSection.title}</h2>
    <div class="gh-before">
      {data.comparisonSection.boxes.map((box, idx) => (
        <article>
          <span>{idx === 0 ? 'A' : 'B'}</span>
          <h3>{box.title}</h3>
          <p>{box.desc}</p>
          <ul class="check-list">
            {box.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="gh-marquee" aria-hidden="true">
  <div class="gh-track">
    {[...extras.marqueeItems, ...extras.marqueeItems].map((item) => (
      <span>{item.quote}</span>
    ))}
  </div>
</div>

<section class="section-white">
  <div class="container" style="max-width: 860px;">
    <span class="micro-label">FAQ</span>
    <h2 class="section-h2">{ui.faqTitle}</h2>
    <div class="faq-list">
      {data.faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="cta-banner">
  <div class="container cta-banner-inner">
    <div>
      <span class="micro-label">{data.bottomCta.microLabel}</span>
      <h2 class="section-h2" style="margin-bottom: 0;">{data.bottomCta.title}</h2>
    </div>
    <a class="btn-primary" href={`/${locale}${data.valueSection.ctaHrefSuffix}`}>
      <span>{data.bottomCta.btn}</span>
      <span class="arrow">→</span>
    </a>
  </div>
</section>

<style>
  .gh-hero {
    background: #fff;
    padding: 56px 0 28px;
  }
  .gh-hero-inner {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 28px;
    align-items: center;
  }
  .gh-art {
    text-align: center;
  }
  .gh-art svg {
    width: min(280px, 100%);
    height: auto;
  }
  .gh-art p {
    margin: 8px 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .gh-orb {
    transform-origin: 140px 148px;
    animation: gh-spin 18s linear infinite;
  }
  .gh-orb-2 {
    animation-duration: 26s;
    animation-direction: reverse;
  }
  .gh-spark {
    animation: gh-twinkle 3.2s ease-in-out infinite;
  }
  .gh-s2 { animation-delay: 0.6s; }
  .gh-s3 { animation-delay: 1.4s; }
  .gh-note {
    max-width: 48ch;
    font-size: 0.92rem;
    color: var(--ink-secondary);
    margin: 0 0 24px;
  }
  .gh-ritual {
    background: #0b0b0b;
    color: #fff;
    padding: 72px 0;
  }
  .gh-ritual .micro-label,
  .gh-ritual .section-h2 {
    color: #fff;
  }
  .gh-ritual .micro-label {
    color: #d4a843;
  }
  .gh-ritual ol {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .gh-ritual time {
    display: block;
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: #d4a843;
    margin-bottom: 12px;
  }
  .gh-ritual h3 {
    margin: 0 0 10px;
    font-size: 1.12rem;
  }
  .gh-ritual p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
  }
  .gh-receipt-wrap {
    padding: 72px 0;
    background: #f7f7f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .gh-receipt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .gh-receipt {
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 22px 24px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    box-shadow: var(--shadow-float);
  }
  .gh-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px dashed #e5e5e0;
    font-size: 0.78rem;
  }
  .gh-line span {
    color: var(--ink-muted);
    text-align: right;
  }
  .gh-receipt .check-list {
    margin-top: 16px;
    font-family: var(--font-sans);
  }
  .gh-before {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 28px;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    overflow: hidden;
  }
  .gh-before article {
    padding: 28px;
  }
  .gh-before article:first-child {
    background: #fafaf9;
    border-right: 1px solid var(--border-subtle);
  }
  .gh-before article > span {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0b0b0b;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .gh-before h3 { margin: 0 0 8px; }
  .gh-before p { margin: 0 0 14px; color: var(--ink-secondary); font-size: 0.92rem; }
  .gh-marquee {
    overflow: hidden;
    background: #fff;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 18px 0;
  }
  .gh-track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: gh-scroll 40s linear infinite;
    font-size: 0.92rem;
    color: var(--ink-secondary);
  }
  .gh-track span::before {
    content: '✦  ';
    color: var(--accent-gold);
  }
  @keyframes gh-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes gh-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1); }
  }
  @keyframes gh-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (max-width: 900px) {
    .gh-hero-inner,
    .gh-ritual ol,
    .gh-receipt-grid,
    .gh-before {
      grid-template-columns: 1fr;
    }
    .gh-before article:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
  }
</style>
