---
import { UI_CHROME, type Locale } from '../data/landings';

interface Props {
  locale: Locale;
  currentPathSuffix: string;
}

const { locale, currentPathSuffix } = Astro.props;
const ui = UI_CHROME[locale];
const homeHref = `/${locale}`;
const blogActive =
  currentPathSuffix === '/blog' || currentPathSuffix.startsWith('/blog/');

const navItems = [
  { href: homeHref, label: ui.nav.home, active: false },
  { href: `${homeHref}/specialists`, label: ui.nav.specialists, active: false },
  { href: `${homeHref}/clinics`, label: ui.nav.clinics, active: false },
  { href: `${homeHref}/about`, label: ui.nav.about, active: false },
  { href: `${homeHref}/blog`, label: ui.nav.blog, active: blogActive },
] as const;
---

<header class="site-header" style="view-transition-name: site-header">
  <div class="site-header-inner">
    <a class="site-brand" href={homeHref} aria-label="Medhub">
      <span class="site-brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
          <path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>
        </svg>
      </span>
      <span>medhub</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          class:list={['site-nav-link', { 'is-active': item.active }]}
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}

      <a class="site-header-cta" href={`/${locale}/specialists`}>
        {ui.headerCta} →
      </a>
    </nav>
  </div>
</header>
