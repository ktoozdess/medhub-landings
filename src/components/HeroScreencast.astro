---
interface Props {
  locale: string;
  title: string;
  tabA: string;
  tabB: string;
  typingQuery: string;
  searchBtn: string;
  rows: Array<{ name: string; meta: string; rating: string }>;
}

const { locale, title, tabA, tabB, typingQuery, searchBtn, rows } = Astro.props;
---

<div class="screencast-window" aria-label="Medhub interactive screencast">
  <!-- Верхняя панель мини-браузера -->
  <div class="sc-browser-bar">
    <div class="sc-dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="sc-url">
      <span class="sc-lock">🔒</span>
      <span>medhub.sk/{locale}</span>
    </div>
    <span class="sc-rec-badge">
      <span class="sc-rec-dot"></span>
      DEMO
    </span>
  </div>

  <!-- Сцена интерфейса Medhub -->
  <div class="sc-stage">
    <div class="sc-mini-header">
      <span class="sc-mini-brand">
        <span class="sc-mini-mark">♡</span>
        <strong>medhub</strong>
      </span>
      <span class="sc-mini-pill">{title}</span>
    </div>

    <div class="sc-search-card">
      <div class="sc-tabs">
        <div class="sc-tab sc-tab-a">{tabA}</div>
        <div class="sc-tab sc-tab-b">{tabB}</div>
      </div>

      <div class="sc-input-row">
        <div class="sc-input-box">
          <span class="sc-magnifier">⌕</span>
          <span class="sc-typed">{typingQuery}</span>
        </div>
        <div class="sc-submit-btn">{searchBtn} →</div>
      </div>

      <!-- Выпадающие результаты поиска -->
      <div class="sc-dropdown">
        {rows.map((row, idx) => (
          <div class={`sc-result-item sc-result-${idx + 1}`}>
            <div>
              <strong>{row.name}</strong>
              <span>{row.meta}</span>
            </div>
            <div class="sc-result-right">
              <span class="sc-stars">{row.rating}</span>
              <span class="sc-verified">✓ Verified</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Анимированный курсор + клик-волна -->
    <div class="sc-cursor" aria-hidden="true">
      <span class="sc-click-ripple"></span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#0B0B0B" stroke="#FFFFFF" stroke-width="1.6">
        <path d="M5 3l14 9-6.2 1.8L9.5 20 5 3z" />
      </svg>
    </div>
  </div>
</div>

<style>
  .screencast-window {
    background: #ffffff;
    border: 1px solid #e3e3de;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 28px 64px rgba(11, 11, 11, 0.09);
  }

  .sc-browser-bar {
    height: 38px;
    padding: 0 14px;
    background: #f5f5f2;
    border-bottom: 1px solid #e8e8e3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .sc-dots {
    display: flex;
    gap: 6px;
  }

  .sc-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d4d4ce;
  }

  .sc-url {
    background: #ffffff;
    border: 1px solid #e6e6e1;
    border-radius: 7px;
    padding: 3px 12px;
    font-size: 0.72rem;
    color: #52525b;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sc-lock {
    font-size: 0.65rem;
  }

  .sc-rec-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #52525b;
  }

  .sc-rec-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16a34a;
    animation: sc-dot-pulse 1.6s infinite;
  }

  .sc-stage {
    position: relative;
    padding: 20px;
    background: linear-gradient(180deg, #f7f7f5 0%, #ffffff 100%);
    min-height: 328px;
    overflow: hidden;
  }

  .sc-mini-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .sc-mini-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }

  .sc-mini-mark {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: #0b0b0b;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.68rem;
  }

  .sc-mini-pill {
    font-size: 0.7rem;
    color: #71717a;
    background: #fff;
    border: 1px solid #e6e6e1;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .sc-search-card {
    background: #ffffff;
    border: 1px solid #eaeae6;
    border-radius: 16px;
    padding: 14px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.04);
  }

  .sc-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 10px;
  }

  .sc-tab {
    text-align: center;
    padding: 8px;
    border-radius: 9px;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid #eaeae6;
  }

  .sc-tab-a {
    animation: sc-tab-a-state 8s ease-in-out infinite;
  }

  .sc-tab-b {
    animation: sc-tab-b-state 8s ease-in-out infinite;
  }

  .sc-input-row {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .sc-input-box {
    flex: 1;
    border: 1px solid #e4e4df;
    border-radius: 10px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    background: #fafaf9;
    overflow: hidden;
  }

  .sc-typed {
    white-space: nowrap;
    overflow: hidden;
    border-right: 2px solid #0b0b0b;
    animation: sc-type 8s steps(26, end) infinite;
  }

  .sc-submit-btn {
    background: #0b0b0b;
    color: #fff;
    padding: 8px 13px;
    border-radius: 10px;
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
    animation: sc-btn-press 8s ease-in-out infinite;
  }

  .sc-dropdown {
    display: grid;
    gap: 8px;
  }

  .sc-result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 11px;
    border: 1px solid #ecece7;
    background: #fff;
  }

  .sc-result-item strong {
    display: block;
    font-size: 0.8rem;
  }

  .sc-result-item span {
    font-size: 0.7rem;
    color: #71717a;
  }

  .sc-result-right {
    text-align: right;
    flex-shrink: 0;
  }

  .sc-stars {
    display: block;
    font-weight: 700;
    color: #0b0b0b !important;
  }

  .sc-verified {
    display: inline-block;
    font-size: 0.64rem !important;
    color: #16a34a !important;
    font-weight: 600;
  }

  .sc-result-1 {
    animation: sc-row1 8s ease-in-out infinite;
  }

  .sc-result-2 {
    animation: sc-row2 8s ease-in-out infinite;
  }

  /* КУРСОР МЫШИ (8-секундный сценарий) */
  .sc-cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    pointer-events: none;
    animation: sc-cursor-path 8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .sc-click-ripple {
    position: absolute;
    top: -6px;
    left: -6px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #0b0b0b;
    opacity: 0;
    animation: sc-ripple 8s ease-out infinite;
  }

  /* Таймлайн 8s:
     0-18%: курсор летит на вкладку Clinics (tabB) и кликает
     20-35%: возврат на Specialists (tabA) -> клик в инпут
     35-60%: печать текста + клик по Search
     62-90%: раскрываются карточки, курсор наводит на row1 (подсветка) */
  @keyframes sc-cursor-path {
    0%   { transform: translate(320px, 270px) scale(1); opacity: 0; }
    8%   { opacity: 1; }
    18%  { transform: translate(295px, 92px) scale(1); }
    21%  { transform: translate(295px, 92px) scale(0.86); }
    25%  { transform: translate(115px, 92px) scale(1); }
    28%  { transform: translate(115px, 92px) scale(0.86); }
    36%  { transform: translate(145px, 140px) scale(1); }
    56%  { transform: translate(355px, 140px) scale(1); }
    59%  { transform: translate(355px, 140px) scale(0.86); }
    72%  { transform: translate(220px, 206px) scale(1); }
    88%  { transform: translate(220px, 206px) scale(1); opacity: 1; }
    100% { transform: translate(320px, 270px) scale(1); opacity: 0; }
  }

  @keyframes sc-ripple {
    0%, 19%, 29%, 60%, 100% { transform: scale(0.4); opacity: 0; }
    21%, 59% { transform: scale(1.6); opacity: 0.45; }
  }

  @keyframes sc-tab-a-state {
    0%, 19% { background: #0b0b0b; color: #fff; border-color: #0b0b0b; }
    21%, 27% { background: #fff; color: #0b0b0b; border-color: #eaeae6; }
    29%, 100% { background: #0b0b0b; color: #fff; border-color: #0b0b0b; }
  }

  @keyframes sc-tab-b-state {
    0%, 19% { background: #fff; color: #0b0b0b; border-color: #eaeae6; }
    21%, 27% { background: #0b0b0b; color: #fff; border-color: #0b0b0b; }
    29%, 100% { background: #fff; color: #0b0b0b; border-color: #eaeae6; }
  }

  @keyframes sc-type {
    0%, 34% { max-width: 0; }
    54%, 92% { max-width: 220px; }
    100% { max-width: 0; }
  }

  @keyframes sc-btn-press {
    0%, 57%, 63%, 100% { transform: scale(1); }
    59% { transform: scale(0.94); }
  }

  @keyframes sc-row1 {
    0%, 56% { opacity: 0.35; transform: translateY(8px); border-color: #ecece7; background: #fff; }
    64% { opacity: 1; transform: translateY(0); }
    72%, 88% { opacity: 1; transform: translateY(0); border-color: #0b0b0b; background: #fafaf8; box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
    96%, 100% { opacity: 0.35; transform: translateY(8px); }
  }

  @keyframes sc-row2 {
    0%, 59% { opacity: 0.25; transform: translateY(10px); }
    68%, 90% { opacity: 1; transform: translateY(0); }
    96%, 100% { opacity: 0.25; transform: translateY(10px); }
  }

  @keyframes sc-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.4); }
  }
</style>