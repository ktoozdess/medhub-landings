---
interface Props {
  microLabel: string;
  title: string;
  cards: Array<{ num: string; title: string; desc: string }>;
  visualLabels: {
    pins: [string, string, string];
    bar1: string;
    bar2: string;
    badges: [string, string, string];
  };
  marqueeItems: Array<{ quote: string; author: string; tag: string }>;
}

const { microLabel, title, cards, visualLabels, marqueeItems } = Astro.props;
---

<section id="how-it-works" class="section-white">
  <div class="container">
    <span class="micro-label">{microLabel}</span>
    <h2 class="section-h2">{title}</h2>

    <div class="bento-grid">
      <article class="bento-card">
        <div class="bento-visual map-visual" aria-hidden="true">
          <div class="map-grid-bg"></div>
          <div class="map-pin pin-1">
            <span class="pin-pulse"></span>
            <span class="pin-tag">{visualLabels.pins[0]}</span>
          </div>
          <div class="map-pin pin-2">
            <span class="pin-pulse"></span>
            <span class="pin-tag">{visualLabels.pins[1]}</span>
          </div>
          <div class="map-pin pin-3">
            <span class="pin-pulse"></span>
            <span class="pin-tag">{visualLabels.pins[2]}</span>
          </div>
        </div>
        <div class="bento-copy">
          <span class="card-num">{cards[0]?.num}</span>
          <h3>{cards[0]?.title}</h3>
          <p>{cards[0]?.desc}</p>
        </div>
      </article>

      <article class="bento-card">
        <div class="bento-visual bars-visual" aria-hidden="true">
          <div class="bar-row">
            <div class="bar-head">
              <span>{visualLabels.bar1}</span>
              <strong>96%</strong>
            </div>
            <div class="bar-track"><div class="bar-fill fill-1"></div></div>
          </div>
          <div class="bar-row">
            <div class="bar-head">
              <span>{visualLabels.bar2}</span>
              <strong>92%</strong>
            </div>
            <div class="bar-track"><div class="bar-fill fill-2"></div></div>
          </div>
          <div class="lang-pills-animated">
            <span class="lp lp-1">SK</span>
            <span class="lp lp-2">EN</span>
            <span class="lp lp-3">UA</span>
            <span class="lp lp-4">RU</span>
            <span class="lp lp-5">DE</span>
          </div>
        </div>
        <div class="bento-copy">
          <span class="card-num">{cards[1]?.num}</span>
          <h3>{cards[1]?.title}</h3>
          <p>{cards[1]?.desc}</p>
        </div>
      </article>

      <article class="bento-card">
        <div class="bento-visual stack-visual" aria-hidden="true">
          <div class="float-badge fb-1">{visualLabels.badges[0]}</div>
          <div class="float-badge fb-2">{visualLabels.badges[1]}</div>
          <div class="float-badge fb-3">{visualLabels.badges[2]}</div>
        </div>
        <div class="bento-copy">
          <span class="card-num">{cards[2]?.num}</span>
          <h3>{cards[2]?.title}</h3>
          <p>{cards[2]?.desc}</p>
        </div>
      </article>
    </div>

    <div class="marquee-wrap" aria-label="Patient experience stream">
      <div class="marquee-track">
        {[...marqueeItems, ...marqueeItems].map((item) => (
          <div class="marquee-card">
            <div class="mq-stars">★★★★★</div>
            <p>“{item.quote}”</p>
            <div class="mq-meta">
              <strong>{item.author}</strong>
              <span>{item.tag}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  .bento-card { border: 1px solid var(--border-subtle); border-radius: 20px; background: #fff; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .bento-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.05); }
  .bento-visual { height: 175px; background: #f7f7f5; border-bottom: 1px solid var(--border-subtle); position: relative; overflow: hidden; padding: 18px; }
  .bento-copy { padding: 22px; }
  .bento-copy h3 { margin: 6px 0 8px; font-size: 1.05rem; letter-spacing: -0.02em; }
  .bento-copy p { margin: 0; font-size: 0.9rem; color: var(--ink-secondary); }
  .map-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(11, 11, 11, 0.045) 1px, transparent 1px), linear-gradient(to bottom, rgba(11, 11, 11, 0.045) 1px, transparent 1px); background-size: 26px 26px; }
  .map-pin { position: absolute; display: flex; align-items: center; gap: 6px; }
  .pin-1 { top: 28px; left: 20px; }
  .pin-2 { top: 76px; right: 18px; }
  .pin-3 { bottom: 24px; left: 42px; }
  .pin-pulse { width: 11px; height: 11px; border-radius: 50%; background: #0b0b0b; box-shadow: 0 0 0 0 rgba(11, 11, 11, 0.35); animation: pin-wave 2.8s infinite; flex-shrink: 0; }
  .pin-2 .pin-pulse { animation-delay: 0.9s; }
  .pin-3 .pin-pulse { animation-delay: 1.8s; }
  .pin-tag { background: #fff; border: 1px solid #e5e5e0; border-radius: 999px; padding: 4px 10px; font-size: 0.72rem; font-weight: 600; box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05); white-space: nowrap; }
  .bars-visual { display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .bar-head { display: flex; justify-content: space-between; font-size: 0.74rem; margin-bottom: 5px; color: var(--ink-secondary); }
  .bar-track { height: 7px; border-radius: 999px; background: #e9e9e4; overflow: hidden; }
  .bar-fill { height: 100%; background: #0b0b0b; border-radius: 999px; animation: bar-grow 4.5s ease-in-out infinite; }
  .fill-1 { width: 96%; }
  .fill-2 { width: 92%; animation-delay: 0.4s; }
  .lang-pills-animated { display: flex; gap: 6px; margin-top: 2px; }
  .lp { font-size: 0.68rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: #fff; border: 1px solid #e5e5e0; animation: pill-highlight 5s infinite; }
  .lp-2 { animation-delay: 1s; }
  .lp-3 { animation-delay: 2s; }
  .lp-4 { animation-delay: 3s; }
  .lp-5 { animation-delay: 4s; }
  .stack-visual { display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .float-badge { background: #fff; border: 1px solid #e5e5e0; border-radius: 12px; padding: 9px 12px; font-size: 0.77rem; font-weight: 600; box-shadow: 0 6px 14px rgba(0, 0, 0, 0.03); animation: badge-float 4.5s ease-in-out infinite; }
  .fb-2 { animation-delay: 0.8s; margin-left: 14px; }
  .fb-3 { animation-delay: 1.6s; }
  .marquee-wrap { margin-top: 40px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track { display: flex; gap: 16px; width: max-content; animation: marquee-scroll 34s linear infinite; }
  .marquee-wrap:hover .marquee-track { animation-play-state: paused; }
  .marquee-card { width: 310px; flex-shrink: 0; background: #fafaf9; border: 1px solid var(--border-subtle); border-radius: 16px; padding: 18px 20px; }
  .mq-stars { color: var(--accent-gold); font-size: 0.9rem; margin-bottom: 8px; }
  .marquee-card p { margin: 0 0 12px; font-size: 0.88rem; color: var(--ink-primary); }
  .mq-meta { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--ink-muted); gap: 8px; }
  @keyframes pin-wave { 0% { box-shadow: 0 0 0 0 rgba(11, 11, 11, 0.35); } 70% { box-shadow: 0 0 0 12px rgba(11, 11, 11, 0); } 100% { box-shadow: 0 0 0 0 rgba(11, 11, 11, 0); } }
  @keyframes bar-grow { 0%, 15% { transform: scaleX(0.35); transform-origin: left; } 45%, 85% { transform: scaleX(1); transform-origin: left; } 100% { transform: scaleX(0.35); transform-origin: left; } }
  @keyframes pill-highlight { 0%, 20%, 100% { background: #fff; color: #0b0b0b; border-color: #e5e5e0; } 8% { background: #0b0b0b; color: #fff; border-color: #0b0b0b; } }
  @keyframes badge-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (max-width: 900px) { .bento-grid { grid-template-columns: 1fr; } }
</style>