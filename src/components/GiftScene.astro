---
interface Props {
  focus: 'visit' | 'hygiene' | 'checkup';
  captions: [string, string, string];
}

const { focus, captions } = Astro.props;

const kinds =
  focus === 'hygiene'
    ? (['spark', 'tooth', 'box'] as const)
    : focus === 'checkup'
      ? (['heart', 'box', 'calendar'] as const)
      : (['box', 'tooth', 'calendar'] as const);
---

<div class="gift-row">
  {
    kinds.map((kind, index) => (
      <figure class={`gift-card gc-${index + 1}`}>
        <div class="gift-art" aria-hidden="true">
          {kind === 'box' && (
            <svg viewBox="0 0 72 72" fill="none">
              <rect x="14" y="30" width="44" height="30" rx="6" fill="#fff" stroke="#0b0b0b" stroke-width="1.6" />
              <path d="M14 40h44" stroke="#0b0b0b" stroke-width="1.6" />
              <path d="M36 30v30" stroke="#d4a843" stroke-width="3" />
              <path d="M18 30c0-8 8-12 14-6 2 2 4 6 4 6" stroke="#0b0b0b" stroke-width="1.6" stroke-linecap="round" />
              <path d="M54 30c0-8-8-12-14-6-2 2-4 6-4 6" stroke="#0b0b0b" stroke-width="1.6" stroke-linecap="round" />
              <path d="M30 24c2 3 4 4 6 4s4-1 6-4" stroke="#d4a843" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          )}
          {kind === 'tooth' && (
            <svg viewBox="0 0 72 72" fill="none">
              <path
                d="M36 14c7 0 12 4 13 10 1 8-1 14-3 22-1 5-3 12-6 12-2 0-3-4-4-8-.6-2-1.2-2-2 0-1 4-2 8-4 8-3 0-5-7-6-12-2-8-4-14-3-22 1-6 6-10 13-10h2z"
                fill="#fff"
                stroke="#0b0b0b"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <path d="M44 18c4 2 6 1 8-2 1 4-1 8-5 9" stroke="#d4a843" stroke-width="1.7" stroke-linecap="round" />
              <path d="M48 14c2-3 6-3 8 0" stroke="#d4a843" stroke-width="1.7" stroke-linecap="round" />
            </svg>
          )}
          {kind === 'heart' && (
            <svg viewBox="0 0 72 72" fill="none">
              <path
                d="M36 54s-16-9.5-16-20a9 9 0 0 1 16-5 9 9 0 0 1 16 5c0 10.5-16 20-16 20z"
                fill="#fff"
                stroke="#0b0b0b"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <path d="M22 36h8l3-6 4 12 3-6h10" stroke="#d4a843" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {kind === 'calendar' && (
            <svg viewBox="0 0 72 72" fill="none">
              <rect x="16" y="18" width="40" height="38" rx="6" fill="#fff" stroke="#0b0b0b" stroke-width="1.6" />
              <path d="M16 30h40" stroke="#0b0b0b" stroke-width="1.6" />
              <path d="M28 14v8M44 14v8" stroke="#0b0b0b" stroke-width="1.6" stroke-linecap="round" />
              <path d="M30 42l5 5 9-11" stroke="#d4a843" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {kind === 'spark' && (
            <svg viewBox="0 0 72 72" fill="none">
              <circle cx="36" cy="38" r="16" fill="#fff" stroke="#0b0b0b" stroke-width="1.6" />
              <path d="M36 28v20M28 36h16" stroke="#d4a843" stroke-width="1.8" stroke-linecap="round" />
              <path d="M50 18l2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5z" fill="#d4a843" />
              <path d="M18 46l1.4 3.2 3.2 1.4-3.2 1.4L18 55l-1.4-3.2-3.2-1.4 3.2-1.4L18 46z" fill="#0b0b0b" />
            </svg>
          )}
        </div>
        <figcaption>{captions[index]}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gift-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 460px;
    margin-top: 8px;
  }

  .gift-card {
    margin: 0;
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 12px 10px 14px;
    box-shadow: 0 10px 24px rgba(11, 11, 11, 0.04);
    text-align: center;
    animation: gift-bob 4.8s ease-in-out infinite;
  }

  .gc-2 {
    animation-delay: 0.6s;
  }

  .gc-3 {
    animation-delay: 1.2s;
  }

  .gift-art {
    height: 72px;
    display: grid;
    place-items: center;
  }

  .gift-art svg {
    width: 68px;
    height: 68px;
  }

  .gift-card figcaption {
    margin-top: 2px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink-secondary);
  }

  @keyframes gift-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (max-width: 720px) {
    .gift-row {
      max-width: none;
    }
  }
</style>
