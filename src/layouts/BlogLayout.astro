---
import '../styles/medhub.css';
import SiteNavbar from '../components/SiteNavbar.astro';
import { LOCALES, HTML_LANG, UI_CHROME, type Locale } from '../data/landings';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPathSuffix: string; // например '/blog' или '/blog/bratislava-specialists'
}

const { locale, title, description, currentPathSuffix } = Astro.props;
const ui = UI_CHROME[locale];
const htmlLang = HTML_LANG[locale];
const canonicalUrl = `https://medhub.sk/${locale}${currentPathSuffix}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={HTML_LANG[loc]}
        href={`https://medhub.sk/${loc}${currentPathSuffix}`}
      />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteNavbar locale={locale} currentPathSuffix={currentPathSuffix} />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a class="footer-brand" href={`/${locale}`}>
              <span class="footer-brand-mark" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
                  <path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>
                </svg>
              </span>
              <span>medhub</span>
            </a>
            <p class="lead-text" style="margin-top: 12px; font-size: 0.88rem;">
              {ui.footerTagline}
            </p>
          </div>

          <div>
            <div class="footer-col-title">{ui.footerNavTitle}</div>
            <div class="footer-links">
              <a href={`/${locale}`}>{ui.nav.home}</a>
              <a href={`/${locale}/specialists`}>{ui.nav.specialists}</a>
              <a href={`/${locale}/clinics`}>{ui.nav.clinics}</a>
              <a href={`/${locale}/about`}>{ui.nav.about}</a>
              <a href={`/${locale}/blog`}>{ui.nav.blog}</a>
            </div>
          </div>

          <div>
            <div class="footer-col-title">{ui.footerLegalTitle}</div>
            <div class="footer-links single">
              <a href={`/${locale}/terms`}>{ui.legal.terms}</a>
              <a href={`/${locale}/privacy`}>{ui.legal.privacy}</a>
              <a href={`/${locale}/cookies`}>{ui.legal.cookies}</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© Medhub</span>
          <div class="lang-switcher" aria-label="Select language">
            {LOCALES.map((loc) => (
              <a
                href={`/${loc}${currentPathSuffix}`}
                class={loc === locale ? 'is-current' : ''}
              >
                {loc}
              </a>
            ))}
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>