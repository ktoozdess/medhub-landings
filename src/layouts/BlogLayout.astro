---
import '../styles/medhub.css';
import { LOCALES, HTML_LANG, UI_CHROME, type Locale } from '../data/landings';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPathSuffix: string; // например '/blog' или '/blog/bratislava-specialists'
}

const { locale, title, description, currentPathSuffix } = Astro.props;
const ui = UI_CHROME[locale];
const htmlLang = HTML_LANG[locale];
const canonicalUrl = `https://medhub.sk/${locale}${currentPathSuffix}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={HTML_LANG[loc]}
        href={`https://medhub.sk/${loc}${currentPathSuffix}`}
      />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-left">
          <a class="brand-logo" href={`/${locale}`}>
            <span class="brand-mark" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 21s-7-4.35-9.33-8.36C.7 9.26 2.5 5 6.5 5c2.24 0 3.74 1.24 5.5 3.1C13.76 6.24 15.26 5 17.5 5c4 0 5.8 4.26 3.83 7.64C19 16.65 12 21 12 21z" />
                <path class="pulse-line" d="M6.5 12h2.5l1.5-2.8 2.3 5.2 1.7-2.4H17.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span>medhub</span>
          </a>

          <nav class="nav-links" aria-label="Main">
            <a href={`/${locale}`}>{ui.nav.home}</a>
            <a href={`/${locale}/specialists`}>{ui.nav.specialists}</a>
            <a href={`/${locale}/clinics`}>{ui.nav.clinics}</a>
            <a href={`/${locale}/about`}>{ui.nav.about}</a>
            <a href={`/${locale}/blog`} class="active">{ui.nav.blog}</a>
          </nav>
        </div>

        <div class="header-actions">
          <a class="pill-outline" href={`/${locale}/specialists`}>
            {ui.headerCta} →
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a class="brand-logo" href={`/${locale}`}>
              <span class="brand-mark" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21s-7-4.35-9.33-8.36C.7 9.26 2.5 5 6.5 5c2.24 0 3.74 1.24 5.5 3.1C13.76 6.24 15.26 5 17.5 5c4 0 5.8 4.26 3.83 7.64C19 16.65 12 21 12 21z" />
                  <path d="M6.5 12h2.5l1.5-2.8 2.3 5.2 1.7-2.4H17.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span>medhub</span>
            </a>
            <p class="lead-text" style="margin-top: 12px; font-size: 0.88rem;">
              {ui.footerTagline}
            </p>
          </div>

          <div>
            <div class="footer-col-title">{ui.footerNavTitle}</div>
            <div class="footer-links">
              <a href={`/${locale}`}>{ui.nav.home}</a>
              <a href={`/${locale}/specialists`}>{ui.nav.specialists}</a>
              <a href={`/${locale}/clinics`}>{ui.nav.clinics}</a>
              <a href={`/${locale}/about`}>{ui.nav.about}</a>
              <a href={`/${locale}/blog`}>{ui.nav.blog}</a>
            </div>
          </div>

          <div>
            <div class="footer-col-title">{ui.footerLegalTitle}</div>
            <div class="footer-links single">
              <a href={`/${locale}/terms`}>{ui.legal.terms}</a>
              <a href={`/${locale}/privacy`}>{ui.legal.privacy}</a>
              <a href={`/${locale}/cookies`}>{ui.legal.cookies}</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© Medhub</span>
          <div class="lang-switcher" aria-label="Select language">
            {LOCALES.map((loc) => (
              <a
                href={`/${loc}${currentPathSuffix}`}
                class={loc === locale ? 'is-current' : ''}
              >
                {loc}
              </a>
            ))}
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>